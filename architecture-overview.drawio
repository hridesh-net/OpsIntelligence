  <diagram id="p05" name="05 — Detail: RepoIntel">
    <mxGraphModel dx="1000" dy="650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="h" value="&lt;b&gt;Detail&lt;/b&gt; — Repo intelligence (&lt;i&gt;repointel&lt;/i&gt;): optional; HTTP routes on Gateway when enabled. Agent tools consume the same index." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="720" height="36" as="geometry"/>
