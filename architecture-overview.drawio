        <mxCell id="er2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#388e3c;strokeWidth=2;" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry"/></mxCell>
