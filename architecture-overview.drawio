  <diagram id="p06" name="06 — Core: LLM ↔ tools loop">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="h" value="&lt;b&gt;RunStream core&lt;/b&gt; — one session turn may iterate until the model stops calling tools.&lt;br&gt;Orthogonal layout: main column + left return path (no crossing)." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="48" y="24" width="820" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="n1" value="Ingress message&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;user / tool / system roles&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;" vertex="1" parent="1">
          <mxGeometry x="340" y="88" width="240" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n1b" value="&lt;b&gt;Optional branch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Orchestrator picks specialist → &lt;i&gt;TaskManager&lt;/i&gt; spawn&lt;br&gt;(keywords + &lt;i&gt;Registry.Best&lt;/i&gt;)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=#e8f5e9;strokeColor=#388e3c;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="620" y="72" width="260" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="Memory read / write&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;internal/memory&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff9c4;strokeColor=#f9a825;" vertex="1" parent="1">
          <mxGeometry x="360" y="168" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="tools.Catalog.SelectForRequest&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;graph.ToolGraph · core slugs + BFS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="330" y="278" width="260" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="provider.Stream (or Complete)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;assistant text + optional tool_calls&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#c62828;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="330" y="366" width="260" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="Tool calls?&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;in this chunk&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;" vertex="1" parent="1">
          <mxGeometry x="375" y="448" width="170" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="ToolRegistry.Execute&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;devops · mcp · bash · subagent · …&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#43a047;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="330" y="556" width="260" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="Append tool results&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;tool-role messages → next model call&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#546e7a;" vertex="1" parent="1">
          <mxGeometry x="330" y="644" width="260" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="Stream tokens / final reply to client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;" vertex="1" parent="1">
          <mxGeometry x="600" y="452" width="260" height="44" as="geometry"/>
        </mxCell>

        <mxCell id="e01" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#1565c0;strokeWidth=2;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e02" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#2e7d32;strokeWidth=2;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e03" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#c62828;strokeWidth=2;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e04a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#f9a825;strokeWidth=2;" edge="1" parent="1" source="n4" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e04y" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#43a047;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n8" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e05" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#546e7a;strokeWidth=2;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e08" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#c62828;strokeWidth=2;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n6" target="n4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="220" y="670"/>
              <mxPoint x="220" y="394"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e07" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#1565c0;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n8" target="n7">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_nb" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;endArrow=open;strokeColor=#388e3c;strokeWidth=1;exitX=0;exitY=0.5;entryX=1;entryY=0.35;" edge="1" parent="1" source="n1b" target="n1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="leg" value="&lt;b&gt;Note&lt;/b&gt;: After &lt;i&gt;Append tool results&lt;/i&gt;, the loop returns to &lt;i&gt;provider.Stream&lt;/i&gt; until the model emits no further tool calls (&lt;i&gt;no&lt;/i&gt; branch)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#546e7a;size=14;align=left;spacingLeft=10;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="48" y="740" width="480" height="56" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
