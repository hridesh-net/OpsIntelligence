  <diagram id="p02" name="02 — Flow: messaging channels">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="h" value="&lt;b&gt;Parallel flow B&lt;/b&gt; — process receives events directly (&lt;i&gt;no Gateway&lt;/i&gt; on this path).&lt;br&gt;Independent of tab 01 (HTTP) and tab 03 (webhooks)." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="28" width="780" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="b1" value="Chat provider (Slack, Teams, Telegram, Discord, WhatsApp, …)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#ad1457;" vertex="1" parent="1">
          <mxGeometry x="120" y="110" width="320" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="b2" value="channels registry + bridge&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;internal/channels — Start(ctx, HandleChannelMessage)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;" vertex="1" parent="1">
          <mxGeometry x="120" y="200" width="320" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="b3" value="Runner (same instance as HTTP)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;RunStream + channel reply callback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="120" y="310" width="320" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="b4" value="Tool execution + LLM (see tab 06)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#43a047;" vertex="1" parent="1">
          <mxGeometry x="120" y="400" width="320" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="eb1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#ad1457;strokeWidth=2;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#7b1fa2;strokeWidth=2;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#2e7d32;strokeWidth=2;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="p03" name="03 — Flow: DevOps webhooks">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="h" value="&lt;b&gt;Parallel flow C&lt;/b&gt; — GitHub/GitLab POST to Gateway &lt;i&gt;/api/webhook/…&lt;/i&gt;. Router acks quickly; work continues async.&lt;br&gt;Independent of tabs 01 and 02." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="28" width="800" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="c1" value="GitHub / GitLab (HTTP POST)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;" vertex="1" parent="1">
          <mxGeometry x="120" y="110" width="300" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="c2" value="webhookadapter.Router&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;verify signature · concurrency limit · dispatch&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#ef6c00;" vertex="1" parent="1">
          <mxGeometry x="120" y="200" width="300" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="c3" value="Runner (dedicated session / webhook runner)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="120" y="310" width="300" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c4" value="DevOps tools + PR / pipeline actions (tab 06)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#43a047;" vertex="1" parent="1">
          <mxGeometry x="120" y="400" width="300" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="ec1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#f9a825;strokeWidth=2;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ec2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#ef6c00;strokeWidth=2;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ec3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#2e7d32;strokeWidth=2;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="p04" name="04 — Detail: Reliable outbound">
    <mxGraphModel dx="1000" dy="650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="h" value="&lt;b&gt;Detail&lt;/b&gt; — outbound replies from tools (not user ingress). DLQ + circuit breaker stay off the main hub." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="680" height="36" as="geometry"/>
